# Fichier d'exemple de configuration pour Docker
# Copiez ce fichier vers .env et remplissez vos valeurs

# === Configuration Flask ===
SECRET_KEY=kandorya-super-secret-key-change-this-in-production
FLASK_ENV=production

# === Configuration de l'application ===
UPLOAD_FOLDER=sources
LLM_PROVIDER=groq

# === Clés API ===
# Groq (recommandé - rapide et efficace)
GROQ_API_KEY=your_groq_api_key_here

# Together AI (alternatif)
# TOGETHER_API_KEY=your_together_api_key_here

# Ollama (local - nécessite un serveur Ollama)
# OLLAMA_SERVER_URL=http://ollama:11434

# === Configuration Docker ===
# Port externe (changez si 5000 est déjà utilisé)
BIBLIOTHEQUE_PORT=5000
